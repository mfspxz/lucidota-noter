{"authority":{"declared_valence":"proven","granted_capabilities":[],"mutation_class":"read_only","required_capability":null},"codon":"ne","contracts":[{"description":"Generate a fresh identity: seed + public parts + fingerprint.","input_schema":{"properties":{},"required":[],"type":"object"},"op":"keygen"},{"description":"AEAD-seal plaintext under a 32-byte key.","input_schema":{"properties":{"key_b64":{"type":"string"},"plaintext_b64":{"type":"string"}},"required":["key_b64","plaintext_b64"],"type":"object"},"op":"seal"},{"description":"AEAD-open a sealed blob under a 32-byte key.","input_schema":{"properties":{"blob_b64":{"type":"string"},"key_b64":{"type":"string"}},"required":["key_b64","blob_b64"],"type":"object"},"op":"unseal"},{"description":"Ed25519-sign a message with an identity seed.","input_schema":{"properties":{"msg_b64":{"type":"string"},"seed_b64":{"type":"string"}},"required":["seed_b64","msg_b64"],"type":"object"},"op":"sign"},{"description":"Ed25519-verify a signature.","input_schema":{"properties":{"ed25519_b64":{"type":"string"},"msg_b64":{"type":"string"},"sig_b64":{"type":"string"}},"required":["ed25519_b64","msg_b64","sig_b64"],"type":"object"},"op":"verify"},{"description":"Fingerprint of a public identity.","input_schema":{"properties":{"ed25519_b64":{"type":"string"},"x25519_b64":{"type":"string"}},"required":["ed25519_b64","x25519_b64"],"type":"object"},"op":"fingerprint"},{"description":"Sealed-box plaintext for a recipient's public identity.","input_schema":{"properties":{"plaintext_b64":{"type":"string"},"recipient":{"type":"object"}},"required":["recipient","plaintext_b64"],"type":"object"},"op":"seal_for"},{"description":"Open a sealed box with our identity seed.","input_schema":{"properties":{"sealed_b64":{"type":"string"},"seed_b64":{"type":"string"}},"required":["seed_b64","sealed_b64"],"type":"object"},"op":"open_from"},{"description":"Argon2id: derive the master key from passphrase + salt hex. Returns only a fingerprint; the key